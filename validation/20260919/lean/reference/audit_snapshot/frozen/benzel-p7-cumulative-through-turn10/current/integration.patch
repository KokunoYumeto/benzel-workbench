+        return r,add(n,scale(r,self.eta(A,B)))
+    def positive_cycle(self,A,r,n):
+        n=self.validate_chain(A,n)
+        return r==1 and all(v>=0 for v in n.values()) and not self.augmented_d(A,r,n)
