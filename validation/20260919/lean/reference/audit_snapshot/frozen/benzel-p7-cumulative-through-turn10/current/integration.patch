+@dataclass(frozen=True)
+class Scalar:
+    present:bool
+    amplitude:int=0
+    def __post_init__(self):
+        G.require(type(self.present)is bool and type(self.amplitude)is int,'G(Z) scalar type')
+        G.require(self.present or self.amplitude==0,'Absent scalar has no amplitude')
